# -----------------------------------------------------------------------------
# Frontend Client Environment Variables (.env.local)
# These variables are bundled into the frontend client. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_ENV=sandbox
VITE_EVENT_PASS_CURRENCY=USD

# -----------------------------------------------------------------------------
# Backend Supabase Edge Function Secrets (Set via: supabase secrets set KEY=VALUE)
# Do NOT prefix with VITE_. Never expose these in client bundles.
# -----------------------------------------------------------------------------
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_ENV=sandbox
# SUPABASE_SERVICE_ROLE_KEY=
