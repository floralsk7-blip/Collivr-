# Edge function secrets. Set them with:
#   npx supabase secrets set --env-file supabase/functions.env
# Copy this file to supabase/functions.env (git-ignored) and fill it in.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.

# Exact frontend origins allowed to start PayPal subscription checkout.
# Include localhost and your production Vercel/custom domain when deployed.
APP_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated platform admin email allowlist for /admin/workspaces.
COLLIVRA_ADMIN_EMAILS=

# Gemini is used for AI project analysis and the explanation text on event teams.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal SANDBOX app credentials (developer.paypal.com).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
EVENT_PASS_CURRENCY=USD

# Filled in automatically by `npm.cmd run setup:plans` (Sandbox IDs).
PAYPAL_PLAN_PREMIUM_MONTHLY=
PAYPAL_PLAN_PREMIUM_YEARLY=
PAYPAL_PLAN_PREMIUM_YEARLY_V2=
PAYPAL_PLAN_INSTITUTION_MONTHLY=
PAYPAL_PLAN_INSTITUTION_YEARLY=
PAYPAL_PLAN_ORGANISATION_MONTHLY=
PAYPAL_PLAN_ORGANISATION_YEARLY=
# Legacy compatibility alias; automatically set to the Institution yearly ID.
PAYPAL_PLAN_COLLEGE_YEARLY=

# SANDBOX ONLY: make the Event Pass payment fail on purpose to test error handling (e.g. INSTRUMENT_DECLINED).
# Leave empty for normal behavior.
PAYPAL_MOCK_CAPTURE_ERROR=